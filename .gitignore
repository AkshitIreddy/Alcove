node_modules
dist

# Local agent handoff — never push (owner keeps this on disk only).
HANDOFF.md
# `dist` above does NOT cover this: the pattern matches a directory named
# exactly `dist`, and the release build writes the compiled frontend to
# `dist-release/` instead — a hundred-odd built JS, CSS and font files that
# turned up untracked and would have been swept into a commit by `git add -A`.
# Same trap `shots-now/out/` fell into.
dist-release

# Playwright E2E artifacts
tests/e2e/.artifacts
test-results
playwright-report
# scheduled task lock
.claude/scheduled_tasks.lock

# Generated art intermediates � the shipped copies live in public/
assets/spinewalls/
assets/spinelayouts/*.png
assets/spines/

# Probe screenshots are regenerated on demand by shots-now/*.mjs.
shots-now/out/
shots-now/bookfit/

# Generated audition track — scripts/audition-sounds.mjs rebuilds it from
# public/sounds/ in a second, and it is 6.8 MB. Committing it would put a
# regenerable binary in history for good, the same trap dist-release/ and
# shots-now/out/ fell into.
qa/sound/

# The demo GIF: generated by shots-now/demo-gif.mjs beside the .webp the
# README actually shows. Same 38 seconds, 7MB against 4MB — keeping both would
# add 11MB to history every time it is re-rendered.
docs/readme/img/demo.gif
qa/demo/
# One-off refutation scripts and their screenshots. Scratch by name and by
# nature: an agent writes one to kill a hypothesis and it has done its job the
# moment the answer is written down. 519 of them were tracked, 85MB, and a
# `git add -A` during a busy session swept in 254 more.
qa/tmp/

# ---------------------------------------------------------------------------
# QA and capture OUTPUT.
#
# `qa/` and `shots-now/` hold two different kinds of thing and only one of them
# belongs in git: the SCRIPTS that drive the app (`shots-now/*.mjs`,
# `scripts/probe-*.mjs`) are the work, and the PICTURES they emit are a run's
# leftovers. 1384 of those pictures were tracked — 384 MB, and the whole
# repository had reached 1.3 GB to clone.
#
# The three sets of pictures that are NOT leftovers stay tracked, because
# something reads them back: `qa/baseline/**` is what `npm run visual` compares
# against, `docs/readme/img/**` is what the README shows, and `assets/brand/**`
# is the app's own mark.
#
# JSON joined the list the same day three probes (`probe-panel-foot.mjs`,
# a panel-drain measurement, `probe-turn-face.mjs`) each wrote their per-frame
# readings to `qa/<name>/*.json` and all three turned up untracked — 20,462
# lines of numbers nobody reads back, the same shape as the pictures above.
# `qa/verify/10-studio-struct.json` predates this rule and stays tracked
# (gitignore never untracks a file already in the index); a NEW probe's JSON
# output should not be added by hand to match it.
# ---------------------------------------------------------------------------
qa/**/*.png
qa/**/*.jpg
qa/**/*.jpeg
qa/**/*.webp
qa/**/*.gif
qa/**/*.json
!qa/baseline/**
shots-now/**/*.png
shots-now/**/*.jpg
shots-now/**/*.jpeg
shots-now/**/*.webp
shots-now/**/*.gif
