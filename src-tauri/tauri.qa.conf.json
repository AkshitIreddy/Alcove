{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alcove QA",
  "identifier": "com.alcove.app.qa",
  "build": {
    "beforeDevCommand": null,
    "devUrl": "http://localhost:1420/?qa-silent=1"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alcove QA",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false,
